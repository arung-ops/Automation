{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "strict": true,

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "resolveJsonModule": true,

    "skipLibCheck": true,

    "types": [
      "node",
      "@playwright/test"
    ],

    "noEmit": true,

    "verbatimModuleSyntax": false,

    "exactOptionalPropertyTypes": false
  },

  "include": [
    "tests/**/*.ts",
    "e2e/**/*.ts",
    "pages/**/*.ts",
    "fixtures/**/*.ts",
    "components/**/*.ts",
    "utils/**/*.ts",
    "config/**/*.ts",
    "playwright.config.ts"
  ]
}